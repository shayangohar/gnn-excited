#!/bin/bash
#SBATCH --job-name=ensemble_blend
#SBATCH --output=runs/%x.%j.%N.out
#SBATCH --error=runs/%x.%j.%N.err
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --account=bhzu-delta-cpu
#SBATCH --constraint="projects&work"
#SBATCH --mail-user=shayangohar@mail.fresnostate.edu
#SBATCH --mail-type=END,FAIL

# TASK-244: val-weighted UMA + ViSNet blends from saved prediction CSVs.
# SPEC is a configs/ensemble_blend_*.yaml; OUT is the JSON report path.
set -euo pipefail
cd /projects/bhzu/gnn-excited
mkdir -p runs
source /etc/profile.d/modules.sh
module purge
source envs/gnn-excited-delta/bin/activate
python scripts/blend_predictions.py --spec "${SPEC:?set SPEC}" --out "${OUT:?set OUT}"
echo BLEND_DONE
